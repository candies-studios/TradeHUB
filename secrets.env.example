# 1. Make a copy of this file and name the copy:  secrets.env
# 2. Paste your own values after the = signs (no spaces, no quotes needed).
# 3. Never upload secrets.env to GitHub. (On GitHub, use Settings > Secrets instead.)

TELEGRAM_BOT_TOKEN=paste-your-bot-token-here
TELEGRAM_CHAT_ID=paste-your-chat-id-here
